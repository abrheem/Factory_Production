<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="factory_view_tree" model="ir.ui.view">
        <field name="name">factory tree</field>
        <field name="model">factory.production</field>
        <field name="arch" type="xml">
            <list string="Production">
                <field name="factory_name"/>
                <field name="product_name"/> 
                <field name="qty_produced"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="factory_view_form" model="ir.ui.view">
        <field name="name">factory form</field>
        <field name="model">factory.production</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <field name="status"  widget="statusbar" clickable="1" options="{'clickable': 1}"/>
                    </header>
                    <div class="oe_title">
                        <label for="ref"/>
                            <h1>
                                <field name="ref"/>
                            </h1>
                        <label for="factory_name"/>
                            <h3>
                                <field name="factory_name"/>
                            </h3>
                    </div>
                    <group>
                        <group>
                            <field name="product_name"/>
                            <field name="production_required"/>
                            <field name="qty_produced"/>
                            <field name="rest"/>
                        </group>
                        <group>
                            <field name="production_date" />
                            <field name="prepared" />
                        </group>
                    </group>
                    <notebook>
                        <page name="note" string="NOTES">
                            <h4>
                                <field name="note"/>
                            </h4>
                        </page>
                    </notebook>
                </sheet>
                
            </form>
        </field>
    </record>
    <record id="factory_action" model="ir.actions.act_window">
        <field name="name">Production</field>
        <field name="res_model">factory.production</field>

    </record>
    <menuitem
        id="model_name_menu"
        name="Productions"
        action="factory_action"
        parent="factory_menu"
        />


</odoo>